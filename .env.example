# ─── Local environment template ──────────────────────────────────────────────
# Copy to .env and fill in ONLY the lines for the script you are running:
#     cp .env.example .env
#
# The web app needs NONE of these — its Supabase URL and publishable key are
# constants in src/supabase.js, so `npm run dev` works with no configuration.
# Everything below is for the maintenance scripts in scripts/.
#
# The scripts read process.env directly and do NOT auto-load this file. Export
# the variables in your shell, or prefix the command:
#     SB_KEY=... node scripts/generate-tasks.mjs
#
# .env is gitignored. Never commit real values. See docs/LOCAL_DEV.md.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Supabase ────────────────────────────────────────────────────────────────
# Defaults to the production project in every script when unset — omitting it
# is the same as pointing at production.
SB_URL=https://ngflppgqohmkkfiljqma.supabase.co

# The service_role key. BYPASSES ROW-LEVEL SECURITY — full read/write on every
# table. Treat as a password: password manager only, never committed.
# Used by: pull-curves, generate-tasks, backfill-rate-history,
#          pull-leasing-email, pull-leasing
SB_KEY=

# backfill-loans.mjs uses these two names instead of SB_URL / SB_KEY.
SUPABASE_URL=https://ngflppgqohmkkfiljqma.supabase.co
SUPABASE_SERVICE_KEY=

# ─── generate-tasks.mjs — nightly tasks + email digest ───────────────────────
# Leave RESEND_API_KEY empty to sync the tasks table WITHOUT emailing anyone.
RESEND_API_KEY=
# Verified sender. Defaults to onboarding@resend.dev, which only delivers to
# the Resend account owner.
TASK_EMAIL_FROM=
# Fallback recipients, used only when the site's Tasks & Reminders → Recipients
# list is empty. Comma-separated.
TASK_EMAIL_TO=
TASK_EMAIL_ACCOUNTING_TO=

# ─── backfill-rate-history.mjs ───────────────────────────────────────────────
# Start of the range to backfill, YYYY-MM-DD. Check it twice before running.
START_DATE=

# ─── pull-curves.mjs — optional CME forward curve ────────────────────────────
# Unset, the script still pulls the free UST 10Y and 30-day Average SOFR feeds.
CME_API_ID=
CME_API_SECRET=

# ─── pull-leasing-email.mjs — weekly leasing ingest ──────────────────────────
# The dedicated Gmail mailbox that receives the forwarded Weekly Leasing
# Summary. LEASING_EMAIL_PASSWORD is a Google App Password, not the account
# password. Never a work account.
LEASING_EMAIL=
LEASING_EMAIL_PASSWORD=
IMAP_HOST=imap.gmail.com

# ─── pull-leasing.mjs — corporate SQL Server warehouse ───────────────────────
# Requires the corporate network; unreachable from off-network. Currently
# superseded by the email ingest above.
DW_SERVER=ec2-dw-prod
DW_USER=
DW_PASSWORD=
DW_DOMAIN=
DW_DATABASE=
DW_PROC=
AS_OF_DATE=

# ─── validate-powerbi-views.mjs — scratch Postgres ───────────────────────────
# A THROWAWAY database. The script drops the public schema on every run.
# Never point this at Supabase.
PGHOST=
PGPORT=
PGUSER=
PGDATABASE=
